# ── Camera ────────────────────────────────────────────────────
CAMERA_IP=192.168.1.100
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
CAMERA_PORT=554
CAMERA_CHANNEL=1
# Use CAMERA_RTSP_PATH to override the path completely (leave blank = auto-build)
CAMERA_RTSP_PATH=
# hikvision  →  rtsp://.../Streaming/Channels/201
# dahua      →  rtsp://.../cam/realmonitor?channel=2&subtype=0
CAMERA_TYPE=dahua

# ── Detection ─────────────────────────────────────────────────
CHECK_INTERVAL_SEC=5
DETECTION_CONF=0.40

# ── Alert thresholds (seconds) ────────────────────────────────
PHONE_THRESHOLD_SEC=300        # 5 min  – continuous phone use
ABSENT_THRESHOLD_SEC=600       # 10 min – not in seat
SLEEP_THRESHOLD_SEC=120        # 2 min  – head-down pose
TIMEWASTE_THRESHOLD_SEC=600    # 10 min – standing/not at desk
PHONE_COOLDOWN_SEC=30          # cooldown between phone alerts

# ── Ollama (optional AI descriptions) ─────────────────────────
# Run: ollama pull llava  then set USE_OLLAMA=true
USE_OLLAMA=false
OLLAMA_MODEL=llava:latest

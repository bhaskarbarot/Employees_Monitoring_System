# ── Camera ────────────────────────────────────────────────────
CAMERA_IP=192.168.1.100
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
CAMERA_PORT=554
CAMERA_CHANNEL=1
# Use CAMERA_RTSP_PATH to override the path completely (leave blank = auto-build)
CAMERA_RTSP_PATH=
# hikvision  →  rtsp://.../Streaming/Channels/201
# dahua      →  rtsp://.../cam/realmonitor?channel=2&subtype=0
CAMERA_TYPE=dahua

# ── Alert thresholds (seconds) ────────────────────────────────
SLEEP_THRESHOLD_SEC=120        # 2 min  – head-down pose before alert
TIMEWASTE_THRESHOLD_SEC=600    # 10 min – looking away / leaning back before alert
PHONE_COOLDOWN_SEC=30          # re-save phone photo every 30 sec while still using phone

# ── Camera angle (critical for time-wasting accuracy) ─────────
# side     = camera to the side of person (profile view)
#            Normal = 1 ear visible.  BOTH ears visible = turned away from screen
# front    = camera faces person directly
#            Normal = 2 ears visible.  Only 1 ear = turned away from screen
# overhead = camera above person (same logic as front)
CAMERA_ANGLE=side

# ── Time-wasting fine-tuning ───────────────────────────────────
EAR_CONF_VISIBLE=0.50          # keypoint confidence >= this → ear is "visible"
EAR_CONF_HIDDEN=0.25           # keypoint confidence <= this → ear is "hidden"
STANDING_RATIO=1.6             # bbox height/width ratio > this = standing
LEANING_BACK_RATIO=1.5         # nose > N × shoulder-span above shoulders = leaning back

# ── Ollama (optional AI descriptions in logs) ──────────────────
# Run: ollama pull llava   then set USE_OLLAMA=true
USE_OLLAMA=false
OLLAMA_MODEL=llava:latest
